# Copy to .env and adjust. docker-compose.yml reads this file for the app
# service; DATABASE_URL and HTTP_ADDR are fixed in docker-compose.yml itself
# (the app only ever talks to the bundled db service, on the port this
# compose file exposes), so they are not listed here.
#
# Every variable below has a default in internal/config/config.go — set one
# here only to override it. Full list of what config.Load recognizes lives
# there; this file only surfaces the ones worth changing for a demo run.

# fake (default, fully offline — no key needed) | exchangeratedev
PROVIDER=fake

# Only read when PROVIDER=exchangeratedev. exchangerate.dev works anonymously
# (docs/design.md §2); set this only if you have a key and want the higher
# quota.
PROVIDER_API_KEY=

# Only "postgres" exists today (internal/config/config.go) — templated here
# for parity with the rest, not because a second backend is wired up yet.
STORAGE=postgres

# debug | info (default) | warn | error
LOG_LEVEL=info

# --- Advanced / rarely needed ---

# HTTP client for the exchangeratedev adapter (built by pkg/httpclient).
# Timeout default: 5s. MaxIdleConnsPerHost default: 8 (matches
# DISPATCH_POOL_SIZE). IdleConnTimeout default: 90s (net/http's own
# DefaultTransport default).
PROVIDER_HTTP_TIMEOUT=
PROVIDER_HTTP_MAX_IDLE_CONNS_PER_HOST=
PROVIDER_HTTP_IDLE_CONN_TIMEOUT=

# Simulated upstream latency for PROVIDER=fake — both zero (default) means
# no delay. A demo run can set these to make the async pending -> succeeded
# gap visible instead of resolving within the same request/poll cycle.
FAKE_PROVIDER_MIN_DELAY=
FAKE_PROVIDER_MAX_DELAY=

# If positive, PROVIDER=fake enforces its own requests-per-minute quota,
# independent of RATE_LIMIT_PER_MINUTE (which bounds the real dispatcher
# regardless of provider). 0 (default) disables it — see docs/design.md §2
# for why production wiring leaves this at zero.
FAKE_PROVIDER_RPM_QUOTA=
